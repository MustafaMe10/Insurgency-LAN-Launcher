<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>Insurgency 2014 - LAN Launcher</title>
<HTA:APPLICATION 
    ID="InsurgencyLauncher"
    APPLICATIONNAME="Insurgency LAN Launcher"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
/>
<style>
    body {
        background-color: #121212;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        margin: 0;
        padding: 15px;
        user-select: none;
    }
    .header {
        background: #1e1e1e;
        padding: 12px 15px;
        border-radius: 6px;
        border: 1px solid #333;
        margin-bottom: 10px;
    }
    .title { color: #ff5500; font-size: 18px; font-weight: bold; float: left; }
    .ip-box {
        float: right;
        background: #1e3a5f;
        border: 1px solid #007acc;
        padding: 4px 10px;
        border-radius: 5px;
        text-align: right;
    }
    .ip-text { color: #00d2ff; font-weight: bold; font-size: 12px; }
    .cmd-text { color: #aaa; font-size: 10px; }
    .clear { clear: both; }

    .path-notice {
        background: #2b1d0c;
        border: 1px solid #ff5500;
        color: #ffaa66;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 11px;
        margin-bottom: 12px;
    }
    
    .main { margin-top: 5px; }
    .left-col { width: 250px; float: left; }
    .right-col { margin-left: 265px; background: #1e1e1e; padding: 12px; border-radius: 6px; border: 1px solid #333; }
    
    label { font-weight: bold; font-size: 11px; color: #ddd; display: block; margin-bottom: 3px; }
    select {
        width: 100%;
        padding: 5px;
        background: #252526;
        color: #fff;
        border: 1px solid #444;
        border-radius: 4px;
        margin-bottom: 8px;
        font-size: 12px;
    }
    .img-box {
        width: 100%;
        height: 250px;
        background: #0d1117;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid #222;
    }
    .btn {
        width: 100%;
        padding: 6px;
        background: #2d2d30;
        color: #fff;
        font-weight: bold;
        font-size: 11px;
        border: 1px solid #444;
        border-radius: 4px;
        cursor: pointer;
        margin-bottom: 6px;
    }
    .btn:hover { background: #3e3e42; }
    .btn-random { background: #1e3a5f; border-color: #007acc; color: #00d2ff; }
    .btn-random:hover { background: #284e7e; }
    .btn-launch {
        width: 100%;
        padding: 12px;
        background: #ff5500;
        color: #fff;
        font-weight: bold;
        font-size: 13px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 4px;
    }
    .btn-launch:hover { background: #e04b00; }
</style>
</head>
<body>

<div class="header">
    <div>
        <div class="title">INSURGENCY 2014 LAN LAUNCHER</div>
        <div class="ip-box">
            <div id="ipDisplay" class="ip-text">Detecting LAN IP...</div>
            <div id="cmdDisplay" class="cmd-text">Friends Command: connect ...</div>
        </div>
        <div class="clear"></div>
    </div>
</div>

<div class="path-notice">
    <strong>NOTICE:</strong> Make sure <code>Launcher.hta</code> is placed directly in your main Insurgency folder (where <code>insurgency.exe</code> exists).
</div>

<div class="main">
    <div class="left-col">
        <label>Game Language:</label>
        <select id="langSelect" onchange="updatePreview()">
            <option value="english" selected>English</option>
            <option value="russian">Russian</option>
            <option value="french">French</option>
            <option value="german">German</option>
            <option value="spanish">Spanish</option>
            <option value="polish">Polish</option>
            <option value="schinese">Simplified Chinese</option>
        </select>

        <label>Game Mode:</label>
        <select id="modeSelect" onchange="updatePreview()">
            <option value="skirmish">Skirmish</option>
            <option value="push">Push</option>
            <option value="firefight">Firefight</option>
            <option value="occupy">Occupy</option>
            <option value="ambush">Ambush</option>
            <option value="strike">Strike</option>
            <option value="checkpoint">Checkpoint (Co-op)</option>
            <option value="hunt">Hunt (Co-op)</option>
            <option value="outpost">Outpost (Co-op)</option>
            <option value="survival">Survival (Co-op)</option>
        </select>

        <label>Select Map:</label>
        <select id="mapSelect" size="6" onchange="updatePreview()">
            <option value="market" selected>Market</option>
            <option value="ministry">Ministry</option>
            <option value="revolt">Revolt</option>
            <option value="sinjar">Sinjar</option>
            <option value="buhriz">Buhriz</option>
            <option value="district">District</option>
            <option value="heights">Heights</option>
            <option value="siege">Siege</option>
            <option value="contact">Contact</option>
            <option value="panj">Panj</option>
            <option value="peak">Peak</option>
            <option value="tell">Tell</option>
            <option value="station">Station</option>
            <option value="dry_canal">Dry Canal</option>
            <option value="uprising">Uprising</option>
            <option value="verticality">Verticality</option>
            <option value="kandagal">Kandagal</option>
        </select>

        <button class="btn btn-random" onclick="pickRandom()">RANDOM MAP & MODE</button>
        <button class="btn" onclick="addCustomMap()">+ ADD CUSTOM MAP</button>
        <button class="btn-launch" onclick="launchGame()">LAUNCH GAME SERVER</button>
    </div>

    <div class="right-col">
        <div id="previewBox" class="img-box"></div>
        <h3 id="mapTitle" style="color: #ff5500; margin-top: 10px; margin-bottom: 4px; font-size: 15px;">MARKET (SKIRMISH)</h3>
        <p id="cmdPreview" style="color: #777; font-family: monospace; font-size: 11px; margin: 0;"></p>
    </div>
    <div class="clear"></div>
</div>

<script language="javascript">
    window.resizeTo(780, 560);

    function getLocalIP() {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            var exec = shell.Exec("cmd.exe /c ipconfig");
            var output = exec.StdOut.ReadAll();
            var lines = output.split("\r\n");
            for (var i = 0; i < lines.length; i++) {
                if (lines[i].indexOf("IPv4 Address") !== -1 || lines[i].indexOf("عنوان IPv4") !== -1 || lines[i].indexOf("IPv4") !== -1) {
                    var parts = lines[i].split(":");
                    if (parts.length > 1) {
                        var ip = parts[1].replace(/\s/g, "").replace(/\(Preferred\)/g, "").replace(/\(مفضل\)/g, "");
                        if (ip !== "" && ip.indexOf("127.0.0.1") === -1 && ip.indexOf("169.254") === -1) {
                            return ip;
                        }
                    }
                }
            }
        } catch(e) {}
        return "127.0.0.1";
    }

    function initIP() {
        var localIP = getLocalIP();
        document.getElementById("ipDisplay").innerText = "Server IP: " + localIP;
        document.getElementById("cmdDisplay").innerText = "Friends Command: connect " + localIP;
    }

    function addCustomMap() {
        var notice = "1. Put your map file in: insurgency\\maps\\\n2. Type map name WITHOUT .bsp (e.g. coop_militia):";
        var mapName = prompt(notice, "");
        if (mapName && mapName.replace(/\s/g, "") !== "") {
            mapName = mapName.toLowerCase().replace(/\.bsp$/i, "").replace(/\s/g, "_");
            var select = document.getElementById("mapSelect");
            var opt = document.createElement("option");
            opt.value = mapName;
            opt.text = mapName;
            opt.selected = true;
            select.add(opt);
            updatePreview();
        }
    }

    function pickRandom() {
        var modeSelect = document.getElementById("modeSelect");
        var mapSelect = document.getElementById("mapSelect");
        
        var randMode = Math.floor(Math.random() * modeSelect.options.length);
        var randMap = Math.floor(Math.random() * mapSelect.options.length);

        modeSelect.selectedIndex = randMode;
        mapSelect.selectedIndex = randMap;

        updatePreview();
    }

    var mapMeta = {
        "market":      { type: "URBAN BAZAAR", color: "#d97706" },
        "ministry":    { type: "CQB FACILITY", color: "#2563eb" },
        "revolt":      { type: "CITY RUINS", color: "#dc2626" },
        "sinjar":      { type: "MOUNTAIN OUTPOST", color: "#b45309" },
        "buhriz":      { type: "RIVER CROSSING", color: "#0d9488" },
        "district":    { type: "NIGHT URBAN", color: "#7c3aed" },
        "heights":     { type: "HILLSIDE VILLAGE", color: "#16a34a" },
        "siege":       { type: "INDUSTRIAL FACTORY", color: "#ea580c" },
        "contact":     { type: "FOREST OUTPOST", color: "#15803d" },
        "panj":        { type: "RURAL FARMLAND", color: "#ca8a04" },
        "peak":        { type: "ALPINE RIDGE", color: "#0284c7" },
        "tell":        { type: "CQB ALLEYWAYS", color: "#e11d48" },
        "station":     { type: "TRAIN DEPOT", color: "#475569" },
        "dry_canal":   { type: "CANAL BASIN", color: "#0284c7" },
        "uprising":    { type: "SLUM COMBAT", color: "#9333ea" },
        "verticality": { type: "CONSTRUCTION SITE", color: "#d97706" },
        "kandagal":    { type: "DESERT VALLEY", color: "#a16207" }
    };

    function renderSvgCard(map, mode) {
        var info = mapMeta[map] || { type: "CUSTOM MAP", color: "#ff5500" };
        var color = info.color;
        var title = map.toUpperCase();
        var tag = info.type;

        return '<svg width="100%" height="100%" viewBox="0 0 400 250" xmlns="http://www.w3.org/2000/svg">' +
            '<rect width="400" height="250" fill="#0d1117"/>' +
            '<defs>' +
                '<pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">' +
                    '<path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1f2937" stroke-width="1"/>' +
                '</pattern>' +
            '</defs>' +
            '<rect width="400" height="250" fill="url(#grid)"/>' +
            '<circle cx="200" cy="125" r="80" fill="none" stroke="' + color + '" stroke-width="1" stroke-dasharray="4 4" opacity="0.4"/>' +
            '<circle cx="200" cy="125" r="40" fill="none" stroke="' + color + '" stroke-width="1" opacity="0.6"/>' +
            '<line x1="200" y1="20" x2="200" y2="230" stroke="' + color + '" stroke-width="1" opacity="0.2"/>' +
            '<line x1="20" y1="125" x2="380" y2="125" stroke="' + color + '" stroke-width="1" opacity="0.2"/>' +
            '<rect x="30" y="30" width="340" height="190" fill="none" stroke="' + color + '" stroke-width="2" rx="6" opacity="0.8"/>' +
            '<text x="200" y="115" font-family="Segoe UI, sans-serif" font-weight="900" font-size="28" fill="#ffffff" text-anchor="middle" letter-spacing="3">' + title + '</text>' +
            '<rect x="110" y="132" width="180" height="22" fill="' + color + '" rx="4"/>' +
            '<text x="200" y="147" font-family="Segoe UI, sans-serif" font-weight="bold" font-size="11" fill="#ffffff" text-anchor="middle" letter-spacing="1">' + tag + '</text>' +
            '<text x="40" y="205" font-family="Consolas, monospace" font-size="10" fill="#9ca3af">MODE: ' + mode.toUpperCase() + '</text>' +
            '<text x="360" y="205" font-family="Consolas, monospace" font-size="10" fill="#9ca3af" text-anchor="end">STATUS: READY</text>' +
            '</svg>';
    }

    function updatePreview() {
        var mapSelect = document.getElementById("mapSelect");
        if (mapSelect.selectedIndex < 0) return;
        var map = mapSelect.value;
        var mode = document.getElementById("modeSelect").value;
        var lang = document.getElementById("langSelect").value;
        
        document.getElementById("previewBox").innerHTML = renderSvgCard(map, mode);
        document.getElementById("mapTitle").innerText = map.toUpperCase() + " (" + mode.toUpperCase() + ")";
        document.getElementById("cmdPreview").innerText = "insurgency.exe -game insurgency -language " + lang + " +sv_lan 1 +map " + map + " " + mode;
    }

    function launchGame() {
        var mapSelect = document.getElementById("mapSelect");
        if (mapSelect.selectedIndex < 0) return;
        var map = mapSelect.value;
        var mode = document.getElementById("modeSelect").value;
        var lang = document.getElementById("langSelect").value;
        
        try {
            var shell = new ActiveXObject("WScript.Shell");
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var loc = decodeURIComponent(window.location.pathname.substring(1));
            shell.CurrentDirectory = fso.GetParentFolderName(loc);

            var cmd = 'insurgency.exe -game insurgency -language ' + lang + ' +sv_lan 1 +map ' + map + ' ' + mode;
            shell.Run(cmd, 1, false);
            window.close();
        } catch(e) {
            alert("Error launching insurgency.exe: " + e.message);
        }
    }

    initIP();
    updatePreview();
</script>

</body>
</html>